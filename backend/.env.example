# Copy this file to .env and fill in the blanks. Never commit .env itself.

# Paste your Neon (or any Postgres) connection string here.
# Looks like: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=""

# Already generated for you — used to sign login tokens. Leave as is.
JWT_SECRET="cd04bfb607fd48693cfb308fb952c658b468ad26204cf423893bee3e48938b65"

# Port the backend runs on locally.
PORT=4000

# Filled in later, once you have a Razorpay test account (Settings -> API Keys).
# Not required to run auth, medicines, orders, or addresses.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
